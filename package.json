{
  "name": "ytm-desktop",
  "productName": "YTM Desktop",
  "version": "1.5.1",
  "description": "Personal desktop window for YouTube Music with a custom layout and colors",
  "main": "src/main.js",
  "author": "dieodoge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "build": "electron-builder --win dir nsis"
  },
  "build": {
    "appId": "local.dieodoge.ytmdesktop",
    "productName": "YTM Desktop",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YTM Desktop",
      "artifactName": "YTM-Desktop-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dieodoge/Funny-Music-App.git"
  }
}
